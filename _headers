/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; font-src 'self'; form-action 'self' mailto:; frame-src https://challenges.cloudflare.com; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: no-store, max-age=0, must-revalidate

/*.html
  Cache-Control: no-store, max-age=0, must-revalidate

/version.json
  Cache-Control: no-store, max-age=0, must-revalidate

/assets/locale-routes.json
  Cache-Control: public, max-age=3600, must-revalidate
